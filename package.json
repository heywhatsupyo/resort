{
  "name": "resort",
  "private": true,
  "description": "Resort comparison app: Vite SPA + D1-backed API on Cloudflare Workers",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "typecheck": "tsc -p worker/tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:import": "wrangler d1 execute resort --file=sql/resorts_sqlite.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.42.0"
  }
}
